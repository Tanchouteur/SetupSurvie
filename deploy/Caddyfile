{
	auto_https off
	admin off
}
:8080 {
	header X-Content-Type-Options nosniff
	handle /health {
		respond "ok" 200
	}
	handle_path /catalog/* {
		root * /srv/catalog
		header Cache-Control "no-store"
		file_server
	}
	handle_path /guides/* {
		root * /srv/guides
		file_server
	}
	handle {
		root * /srv/portal
		file_server
	}
}
