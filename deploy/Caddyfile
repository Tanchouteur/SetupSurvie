{
	auto_https disable_redirects
	default_sni {$TLS_FALLBACK_HOST:localhost}
	admin off
}
(portal_routes) {
	header X-Content-Type-Options nosniff
	# Compress text only: event streams, PDFs, tiles and media keep their own
	# encoding and byte ranges. Portal assets shrink about threefold.
	encode {
		gzip 5
		zstd
		minimum_length 1024
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type text/markdown*
			header Content-Type text/plain*
		}
	}
	handle /api/* {
		reverse_proxy pilot:8000
	}
	@encyclopedia path /encyclopedie/search /encyclopedie/catalog/v2/entries
	handle @encyclopedia {
		uri strip_prefix /encyclopedie
		reverse_proxy kiwix:8080
	}
	handle /health {
		respond "ok" 200
	}
	handle_path /catalog/* {
		root * /srv/catalog
		header Cache-Control "no-store"
		file_server
	}
	handle_path /guides/* {
		header Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
		root * /srv/guides
		file_server
	}
	handle {
		# build_portal.py writes the content hash in each local ?v= link: such a
		# file never changes under the same address, unlike the pages themselves.
		@versioned query v=*
		@unversioned not query v=*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		header @unversioned Cache-Control "no-cache"
		root * /srv/portal
		file_server
	}
}
(webui_routes) {
    route {
        request_header -X-Survie-Email
        request_header -X-Survie-Name
        request_header -X-Survie-Role
        forward_auth pilot:8000 {
            uri /api/profiles/webui-headers
            copy_headers X-Survie-Email X-Survie-Name X-Survie-Role
        }
        reverse_proxy open-webui:8080
    }
}
:3000 {
    import webui_routes
}
:8080 {
	import portal_routes
}
{$TLS_PORTAL_ADDRESSES:https://localhost:8443} {
	tls internal
	import portal_routes
}
{$TLS_WEBUI_ADDRESSES:https://localhost:8444} {
	tls internal
	import webui_routes
}
{$TLS_KIWIX_ADDRESSES:https://localhost:8445} {
	tls internal
	reverse_proxy kiwix:8080
}
