* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
deploy/Caddyfile text eol=lf

# The portal uses the actual CSS and JS bytes for its asset fingerprints.
portal/**/*.css text eol=lf
portal/**/*.js text eol=lf

# Verified upstream assets: preserve exact bytes on Windows and upstream spacing.
portal/vendor/pdfjs/** -text -whitespace
